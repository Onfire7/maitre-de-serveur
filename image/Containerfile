# Maître Server: a bootc image. The whole OS is this container image; bootc
# installs it to disk and updates it atomically. See docs/adr/0001.
#
# Build from the repo root:  podman build -f image/Containerfile -t maitre-server .

FROM docker.io/library/golang:1.27 AS agent
WORKDIR /src
COPY server/go.mod server/go.sum ./
COPY server/third_party/ ./third_party/
RUN go mod download
COPY server/ ./
ARG VERSION=dev
# GOTAGS is how an image asks for the debug console's remote surface
# (decision 323): `maitredebug` compiles in DebugReadFile and DebugExec,
# and empty — the default, and every published image — leaves the
# procedures out of the binary altogether rather than guarded inside it.
# `make image-debug` sets it and names the image :<version>-debug, because
# the risk 323 names is a debug image running in production unnoticed.
ARG GOTAGS=
RUN CGO_ENABLED=0 go build -tags "${GOTAGS}" -ldflags "-X main.version=${VERSION}" -o /maitre ./cmd/maitre
# The Catalog index baked into the image; the agent refreshes it from the
# network later. Validates every entry as a side effect.
COPY catalog/ /catalog/
RUN /maitre catalog-index --out /catalog.json /catalog/entries

# Fedora's own registry; quay.io mirrors the same image but has had outages.
FROM registry.fedoraproject.org/fedora-bootc:42

# Runtime for Services, storage, and discovery. Kept deliberately short;
# anything else is a container. podman, nfs-utils and avahi already ship in
# fedora-bootc; nss-mdns is what lets the host resolve *.local names;
# dracut-live builds the netboot installer initramfs (decision 79).
# acl: setfacl for Spaces' shared folders (decision 182).
# ktls-utils: tlshd, the TLS handshake for NFS over TLS (decision 188).
# ipxe-bootimgs-x86: undionly.kpxe, how a Depot netboots BIOS machines
# (decision 223); noarch, no dependencies.
# snapraid: parity per Space on Parity Drives (ADR 0009); Fedora packages 15.0.
# zram-generator: swap in compressed RAM rather than on a disk (decision
# 322), so a memory spike stops being terminal on a Node with no swap at
# all and no good place to put a swap file.
RUN dnf -y install nss-mdns e2fsprogs caddy skopeo dracut-live greenboot rsync acl ktls-utils ipxe-bootimgs-x86 snapraid zram-generator policycoreutils-python-utils && dnf clean all

# mergerfs is not packaged in Fedora. Install the upstream release RPM,
# pinned by version and checked against its published sha256 (ADR 0004).
ARG MERGERFS_VERSION=2.42.0
ARG MERGERFS_SHA256=b2950da251247c1f6573c071befde649b674bc6c8b5f5a23ca82a01347a0b1d3
RUN set -eu; arch="$(uname -m)"; \
    rpm="mergerfs-${MERGERFS_VERSION}-1.fc42.${arch}.rpm"; \
    curl -fsSL -o "/tmp/${rpm}" \
      "https://github.com/trapexit/mergerfs/releases/download/${MERGERFS_VERSION}/${rpm}"; \
    if [ "${arch}" = x86_64 ]; then echo "${MERGERFS_SHA256}  /tmp/${rpm}" | sha256sum -c -; fi; \
    dnf -y install "/tmp/${rpm}" && dnf clean all && rm -f "/tmp/${rpm}"

ARG VERSION=dev
# The version the Depot and the Console show for this image; bootc reports
# the plain "version" label as the deployment's version.
LABEL org.opencontainers.image.version="${VERSION}" version="${VERSION}"
LABEL org.opencontainers.image.source="https://github.com/Onfire7/maitre-de-serveur" \
      org.opencontainers.image.licenses="GPL-3.0-only"
COPY --from=agent /maitre /usr/bin/maitre
COPY --from=agent /catalog.json /usr/share/maitre/catalog.json
COPY image/maitre.network /etc/containers/systemd/maitre.network
COPY image/kargs.d/ /usr/lib/bootc/kargs.d/
# Health-gated updates (Milestone 6): greenboot runs the check after every
# boot and falls back to the previous image after repeated failures.
COPY image/greenboot/10-maitre.sh /etc/greenboot/check/required.d/10-maitre.sh
# Decision 324: a wanted check, so a full root is reported without greenboot
# rolling the image back over it, which would free nothing.
COPY image/greenboot/20-maitre-space.sh /etc/greenboot/check/wanted.d/20-maitre-space.sh
COPY image/greenboot/red-maitre.sh /etc/greenboot/red.d/10-maitre.sh
COPY image/logind.conf /usr/lib/systemd/logind.conf.d/10-maitre.conf
# Decision 322: a quarter of RAM as compressed swap, never more than 4 GiB.
COPY image/zram-generator.conf /usr/lib/systemd/zram-generator.conf
COPY image/tlshd.conf /etc/tlshd/config
# A panic's own words, kept in the memory region kargs.d reserves and put
# into the journal on the next boot, because a Node has no terminal to
# print them to and nobody is watching the one it has.
COPY image/ramoops.conf /usr/lib/modules-load.d/ramoops.conf
COPY image/maitre-panic.sh /usr/libexec/maitre-panic.sh
# Nothing should ever suspend a Node, lid or no lid.
RUN systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target
COPY image/maitre-agent.service image/maitre-installer.service image/maitre-pool.service image/maitre-panic.service image/var-lib-maitre.mount /usr/lib/systemd/system/
# Caddy starts with its stock config; the agent replaces it over the admin API.
RUN systemctl enable maitre-agent.service maitre-installer.service maitre-pool.service maitre-panic.service var-lib-maitre.mount avahi-daemon.service podman.socket caddy.service greenboot-healthcheck.service tlshd.service systemd-pstore.service \
    && mkdir -p /etc/exports.d

# bootc lint catches image-layout mistakes at build time.
RUN bootc container lint
