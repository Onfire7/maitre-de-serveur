[Unit]
Description=Maître installer (runs only from installer media)
Documentation=https://github.com/Onfire7/maitre-de-serveur
After=network-online.target avahi-daemon.service
Wants=network-online.target avahi-daemon.service
ConditionKernelCommandLine=maitre.installer
# The screen owns tty1; no login prompt there.
Conflicts=getty@tty1.service

[Service]
Type=simple
# Image to install and other settings come from the kernel command line
# (maitre.image=, maitre.insecure_registry=), baked into the media by the
# image build.
ExecStart=/usr/bin/maitre installer
Restart=on-failure
RestartSec=5
# The screen (decision 261), as the agent's: tty1 with its keyboard, and
# logs to the journal only (its Log page shows them), since the console
# would scribble over the screen.
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=TERM=linux

[Install]
WantedBy=multi-user.target
