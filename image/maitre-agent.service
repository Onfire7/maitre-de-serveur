[Unit]
Description=Maître agent
Documentation=https://github.com/Onfire7/maitre-de-serveur
After=network-online.target podman.socket avahi-daemon.service caddy.service maitre-pool.service
Wants=network-online.target podman.socket avahi-daemon.service caddy.service maitre-pool.service
# Installer media boots with maitre.installer on the kernel command line;
# then the installer runs instead of the agent.
ConditionKernelCommandLine=!maitre.installer
# The config partition (label maitre-config) holds identity and Fleet DB.
RequiresMountsFor=/var/lib/maitre
# The status text owns tty1 (decision 72); no login prompt there.
Conflicts=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/bin/maitre agent --state /var/lib/maitre
Restart=always
RestartSec=2
# Status text (stdout) goes to the monitor; logs (stderr) go to the journal
# and the console so the QEMU boot test can read them on the serial line.
StandardOutput=tty
StandardError=journal+console
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
